[Unit]
Description=Trade Collector Service
After=network.target
Wants=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/trade-collector

# КРИТИЧЕСКИ ВАЖНО: загружаем переменные из файла
EnvironmentFile=/etc/default/trade-collector

ExecStart=/opt/trade-collector/run.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trade-collector

# Ограничения для стабильной работы
LimitNOFILE=65536
LimitNPROC=65536

[Install]
WantedBy=multi-user.target