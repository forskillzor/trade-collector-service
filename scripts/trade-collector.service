[Unit]
Description=Trade Collector Service
After=network.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/trade-collector
ExecStart=/usr/bin/java \
  --add-opens=java.base/java.nio=ALL-UNNAMED \
  --add-opens=java.base/sun.nio.ch=ALL-UNNAMED \
  -XX:MaxRAMPercentage=75.0 \
  -jar /opt/trade-collector/trade-collector.jar \
  --config /opt/trade-collector/config.json
Restart=always
RestartSec=10
StandardOutput=append:/var/log/trade-collector/app.log
StandardError=append:/var/log/trade-collector/error.log

[Install]
WantedBy=multi-user.target