[Unit]
Description=Trade Collector Service
After=network.target pgbouncer.service
Wants=pgbouncer.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/trade-collector

Environment=DB_PASSWORD=%DB_PASSWORD%
Environment=DB_HOST=%DB_HOST%
Environment=DB_PORT=%DB_PORT%
Environment=DB_USER=%DB_USER%
Environment=DB_NAME=%DB_NAME%

ExecStart=/opt/trade-collector/run.sh
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=trade-collector

[Install]
WantedBy=multi-user.target