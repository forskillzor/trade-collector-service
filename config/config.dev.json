{
  "exchanges": [
    {
      "name": "Binance",
      "symbols": ["btcusdt", "ethusdt", "bnbusdt", "xrpusdt", "solusdt", "trxusdt", "hypeusdt", "dogeusdt", "zecusdt",
        "adausdt", "xlmusdt", "linkusdt", "xmpusdt", "bchusdt", "tonusdt", "daiusdt", "musdt", "ltcusdt", "avaxusdt",
        "suiusdt"],
      "enabled": true
    }
  ],
  "database": {
    "type": "postgresql",
    "host": "localhost",
    "port": 5432,
    "database": "trade_collector",
    "username": "trade_user",
    "password": null,
    "batchSize": 1000,
    "flushIntervalMs": 1000
  },
  "processor": {
    "batchSize": 1000,
    "flushIntervalMs": 1000,
    "windowSize": 10000,
    "slideStep": 1000,
    "filterPercentile": 0.98,
    "timeframes": ["1m", "15m"]
  },
  "export": {
    "enabled": false,
    "intervalMinutes": 60,
    "outputDir": "./exports",
    "keepDays": 7
  },
  "monitoring": {
    "httpPort": 8080,
    "host": "localhost",
    "enableMetrics": true,
    "metricsPath": "/metrics",
    "healthPath": "/health",
    "statusPath": "/status"
  }
}
