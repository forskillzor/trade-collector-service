{
  "exchanges": [
    {
      "name": "Binance",
      "symbols": ["btcusdt", "ethusdt", "solusdt", "adausdt", "dotusdt"],
      "enabled": true
    }
  ],
  "database": {
    "type": "postgresql",
    "host": "localhost",
    "port": 5432,
    "database": "trade_collector",
    "username": "trade_user",
    "password": null,
    "batchSize": 5000,
    "flushIntervalMs": 500
  },
  "processor": {
    "batchSize": 5000,
    "flushIntervalMs": 500,
    "windowSize": 1000000,
    "slideStep": 100000,
    "filterPercentile": 0.98,
    "timeframes": ["1m", "5m", "15m", "1h", "4h"]
  },
  "export": {
    "enabled": true,
    "intervalMinutes": 60,
    "outputDir": "/var/lib/trade-collector/exports",
    "keepDays": 30
  },
  "monitoring": {
    "httpPort": 8080,
    "host": "0.0.0.0",
    "enableMetrics": true,
    "metricsPath": "/metrics",
    "healthPath": "/health",
    "statusPath": "/status"
  }
}