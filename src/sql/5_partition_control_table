-- Таблица для управления жизненным циклом партиций
CREATE TABLE partition_management (
    id SERIAL PRIMARY KEY,
    table_name VARCHAR(50) NOT NULL,      -- 'raw_ticks' или 'filtered_ticks'
    partition_name VARCHAR(100) NOT NULL, -- Имя физической таблицы-партиции
    start_time BIGINT NOT NULL,           -- Начало диапазона
    end_time BIGINT NOT NULL,             -- Конец диапазона
    row_count BIGINT DEFAULT 0,           -- Количество строк
    size_bytes BIGINT DEFAULT 0,          -- Размер в байтах
    status VARCHAR(20) DEFAULT 'active',  -- 'active', 'archived', 'dropped'
    
    -- Статистика использования
    last_accessed TIMESTAMP,
    access_count INTEGER DEFAULT 0,
    
    -- Планирование очистки
    scheduled_for_cleanup DATE,           -- Когда планируется удаление
    cleanup_status VARCHAR(20),           -- 'pending', 'completed', 'failed'
    
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    UNIQUE (table_name, partition_name)
);

-- Индексы для управления партициями
CREATE INDEX idx_partition_management_schedule 
    ON partition_management(scheduled_for_cleanup) 
    WHERE status = 'active';

-- Триггер для обновления статистики при доступе
CREATE OR REPLACE FUNCTION update_partition_stats()
RETURNS TRIGGER AS $$
BEGIN
    UPDATE partition_management 
    SET last_accessed = CURRENT_TIMESTAMP,
        access_count = access_count + 1,
        updated_at = CURRENT_TIMESTAMP
    WHERE table_name = TG_TABLE_NAME::TEXT
      AND partition_name = TG_TABLE_NAME::TEXT || '_' || 
          to_char(to_timestamp(NEW.timestamp/1000), 'YYYY_MM_DD');
    RETURN NEW;
END;
$$ LANGUAGE plpgsql;

