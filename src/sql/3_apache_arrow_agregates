-- Таблица для хранения ссылок на Arrow/Parquet файлы с агрегатами
CREATE TABLE aggregates (
    id UUID DEFAULT uuid_generate_v4() PRIMARY KEY,
    
    -- Метаданные
    exchange VARCHAR(20) NOT NULL,
    symbol VARCHAR(20) NOT NULL,
    timeframe VARCHAR(10) NOT NULL,  -- '1m', '5m', '1h', '4h', '1d'
    
    -- Временной диапазон
    start_time BIGINT NOT NULL,      -- Начало периода
    end_time BIGINT NOT NULL,        -- Конец периода
    
    -- Информация о файле
    file_path TEXT NOT NULL,         -- Путь к Arrow/Parquet файлу
    file_size BIGINT,                -- Размер файла в байтах
    compression_type VARCHAR(20),    -- 'zstd', 'gzip', 'none'
    compression_ratio DECIMAL(5,2),  -- Коэффициент сжатия
    
    -- Статистика
    candle_count INTEGER,            -- Количество свечей в файле
    avg_price_levels INTEGER,        -- Среднее количество уровней на свечу
    total_trades BIGINT,             -- Общее количество тиков
    
    -- Технические поля
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    updated_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    
    -- Проверки
    CONSTRAINT timeframe_check CHECK (timeframe IN ('1m', '5m', '15m', '30m', '1h', '4h', '1d')),
    CONSTRAINT time_range_check CHECK (end_time > start_time)
);

-- Индексы для быстрого поиска агрегатов
CREATE INDEX idx_aggregates_exchange_symbol_timeframe 
    ON aggregates(exchange, symbol, timeframe);

CREATE INDEX idx_aggregates_time_range 
    ON aggregates(start_time, end_time);

-- Индекс для поиска по пути к файлу (для обслуживания)
CREATE INDEX idx_aggregates_file_path 
    ON aggregates(file_path);

-- Триггер для обновления updated_at
CREATE OR REPLACE FUNCTION update_updated_at_column()
RETURNS TRIGGER AS $$
BEGIN
    NEW.updated_at = CURRENT_TIMESTAMP;
    RETURN NEW;
END;
$$ language 'plpgsql';

CREATE TRIGGER update_aggregates_updated_at 
    BEFORE UPDATE ON aggregates 
    FOR EACH ROW EXECUTE FUNCTION update_updated_at_column();
