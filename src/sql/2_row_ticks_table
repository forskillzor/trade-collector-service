-- Создаём таблицу с партиционированием по времени
CREATE TABLE raw_ticks (
    -- Уникальный ID
    id BIGSERIAL NOT NULL,
    
    -- Идентификаторы
    exchange VARCHAR(20) NOT NULL,  -- Binance, Bybit
    symbol VARCHAR(20) NOT NULL,    -- BTCUSDT, ETHUSDT
    
    -- Данные сделки
    timestamp BIGINT NOT NULL,      -- Unix timestamp в миллисекундах
    price DECIMAL(20, 8) NOT NULL,  -- Цена с точностью до 8 знаков
    quantity DECIMAL(30, 8) NOT NULL, -- Объём
    is_buy BOOLEAN NOT NULL,        -- true = BUY, false = SELL
    
    -- Технические поля
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    source_ip INET,                 -- Для отладки
    
    -- Ограничения
    PRIMARY KEY (id, timestamp)
) PARTITION BY RANGE (timestamp);

-- Индексы для быстрого поиска
CREATE INDEX idx_raw_ticks_exchange_symbol 
    ON raw_ticks(exchange, symbol);

CREATE INDEX idx_raw_ticks_timestamp 
    ON raw_ticks(timestamp DESC);

-- Функция для автоматического создания партиций по дням
CREATE OR REPLACE FUNCTION create_daily_partition()
RETURNS void AS $$
DECLARE
    partition_name TEXT;
    start_date DATE;
    end_date DATE;
BEGIN
    start_date := CURRENT_DATE + INTERVAL '1 day';
    end_date := start_date + INTERVAL '1 day';
    partition_name := 'raw_ticks_' || to_char(start_date, 'YYYY_MM_DD');
    
    EXECUTE format('
        CREATE TABLE IF NOT EXISTS %I 
        PARTITION OF raw_ticks
        FOR VALUES FROM (%L) TO (%L)',
        partition_name,
        EXTRACT(EPOCH FROM start_date) * 1000,
        EXTRACT(EPOCH FROM end_date) * 1000
    );
    
    RAISE NOTICE 'Created partition: %', partition_name;
END;
$$ LANGUAGE plpgsql;

-- Создаём первую партицию на сегодня
SELECT create_daily_partition();
