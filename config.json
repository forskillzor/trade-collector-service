{
  "exchanges": [
    {
      "name": "Binance",
      "symbols": ["ltcusdt"],
      "enabled": true
    }
  ],
  "database": {
    "type": "postgresql",
    "batchSize": 1000,
    "flushIntervalMs": 1000
  },
  "processor": {
    "windowSize": 1000000,
    "slideStep": 100000,
    "filterPercentile": 0.98,
    "timeframes": ["1m", "5m", "1h"],
    "aggregatesOutputDir": "./aggregates"
  },
  "export": {
    "enabled": true,
    "intervalMinutes": 60,
    "outputDir": "./exports",
    "keepDays": 7
  },
  "monitoring": {
    "httpPort": 8080,
    "enableMetrics": true,
    "metricsPath": "/metrics",
    "healthPath": "/health",
    "statusPath": "/status"
  }
}